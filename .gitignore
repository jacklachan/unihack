.env
__pycache__/
*.pyc
data/full_run*.log
caliper/web/_upload.csv
data/out_probe/
data/out_audit/

# Generated outputs: ship the deliverables so the results can be read without
# running anything, but not the 3.5 MB provenance ledger or the raw fact dumps.
data/out/*
!data/out/delivery.csv
!data/out/delivery.xlsx
!data/out/report.json
!data/out/review_queue.csv
!data/out/relationships.csv
!data/out/evaluation.json
!data/out/inspect.json
data/deck/render/
docs/deck/render/

# The AI-path run: keep the report and the corrections it produced as evidence,
# drop the multi-megabyte graph and provenance dumps that nothing reads.
data/out_ai/*
!data/out_ai/report.json
!data/out_ai/corrections.csv
