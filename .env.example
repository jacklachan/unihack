# CALIPER runs fully without any of these. The model layer is an upgrade,
# not a dependency: with no key the deterministic engines still produce all
# 252 columns. Set ONE of the following and CALIPER will pick it up.

# Free tier, fastest to get: https://console.groq.com/keys
GROQ_API_KEY=

# Free tier, has vision: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
